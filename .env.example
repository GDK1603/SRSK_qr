# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYMENT_KEY_ID: Merchant Payment Gateway Key ID (e.g., Razorpay/Cashfree/Bank Key ID)
# Provide your Key ID whenever you are ready. The applet automatically uses it.
PAYMENT_KEY_ID=""

# PAYMENT_KEY_SECRET: Merchant Gateway Secret Key
PAYMENT_KEY_SECRET=""

# PAYMENT_WEBHOOK_SECRET: Webhook signing secret for incoming payment soundbox/bank notifications
PAYMENT_WEBHOOK_SECRET=""

# Google Pay for Business Merchant Configuration
# Official Google Pay Business Merchant ID
GOOGLE_PAY_MERCHANT_ID="BCR2DN4TZLBYBEIY"

# Store Merchant UPI credentials
MERCHANT_UPI_ID="9533455562@okbizaxis"
MERCHANT_NAME="SAI Krishna Graphics"


